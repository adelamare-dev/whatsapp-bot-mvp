# ═══════════════════════════════════════════════════════════════════════════════
# OCTAVE Baileys Worker – Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
#
# SECURITY: Never commit .env – only .env.example
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Worker HTTP Server
# ─────────────────────────────────────────────────────────────────────────────

# Port for the Express HTTP server (receives /send requests from backend)
# Default: 3000
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# FastAPI Backend Integration
# ─────────────────────────────────────────────────────────────────────────────

# URL of the OCTAVE FastAPI backend (for forwarding WhatsApp messages)
# Default: http://localhost:8000
FASTAPI_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Baileys Configuration
# ─────────────────────────────────────────────────────────────────────────────

# PHONE NUMBER IN E164 format (e.g., 33612345678 for +33612345678 french number)
WHATSAPP_PHONE_NUMBER=your_phone_number

# Folder to store WhatsApp authentication state
# Default: auth_info_baileys
# AUTH_STATE_FOLDER=auth_info_baileys

# Connection timeout in milliseconds
# Default: 60000
# CONNECT_TIMEOUT_MS=60000

# Delay before retrying failed requests in milliseconds
# Default: 5000
# RETRY_REQUEST_DELAY_MS=5000

# Delay before restarting after disconnect in milliseconds
# Default: 5000
# RESTART_DELAY_MS=5000

# Timeout for FastAPI requests in milliseconds
# Default: 30000
# FASTAPI_REQUEST_TIMEOUT_MS=30000
